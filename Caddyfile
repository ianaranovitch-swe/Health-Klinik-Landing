{
	# Глобальные настройки для Railway
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

# Слушаем порт, который даёт Railway ($PORT)
:{$PORT:8080} {
	log {
		format json
	}

	root * /srv
	encode gzip

	# Не кэшируем HTML/JS/CSS надолго (Cloudflare иначе держит старую форму 4ч)
	header Cache-Control "no-cache, must-revalidate"

	# Простая проверка живости сервиса
	handle /health {
		respond "ok" 200
	}

	# robots.txt: реальные переносы строк (backticks), Sitemap на текущий Host
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `User-agent: *
Allow: /

Sitemap: https://{http.request.host}/sitemap.xml
` 200
	}

	# Staging/Railway-хост не индексируем — canonical всегда указывает на прод
	@not_prod {
		not host mrboka.com www.mrboka.com
	}
	header @not_prod X-Robots-Tag "noindex, nofollow"

	# sitemap: только корень без #фрагментов; Host из запроса
	handle /sitemap.xml {
		header Content-Type "application/xml; charset=utf-8"
		respond `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://{http.request.host}/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
` 200
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
