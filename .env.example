# === PostgreSQL (Railway) ===
# Railway → Postgres → Variables → DATABASE_URL
# postgres:// тоже ок — код нормализует в postgresql+psycopg://
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/railway

# === FastAPI (этап 2) ===
BOT_USERNAME=YourBotUsername
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,https://mrboka.com,https://www.mrboka.com

# === Email / Resend (этап 5) ===
# Ключ из https://resend.com — домен mrboka.com должен быть верифицирован
RESEND_API_KEY=
# Отправитель зафиксирован в коде: info@mrboka.com

# === Сиды (два терапевта) ===
# Viktoria — Monicor, EIS, Alfa
SEED_VIKTORIA_TELEGRAM_ID=7973899604
SEED_VIKTORIA_EMAIL=mail@mr-ab.se
SEED_VIKTORIA_NAME=Viktoria Antropova
# Iwona — Monicor & Alfa (укажи её реальный telegram_id)
SEED_IWONA_TELEGRAM_ID=2000000001
SEED_IWONA_EMAIL=iwona@mr-ab.se
SEED_IWONA_NAME=Iwona Aranovitch

